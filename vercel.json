{
  "rewrites":[
    {
      "source": "/api/:path*",
      "destination": "https://nefusoft.my.id/api/:path*"
    },
    {
      "source": "/(.*\\.mp4)",
      "has":[
        {
          "type": "query",
          "key": "url",
          "value": "(?<url>.*)"
        }
      ],
      "destination": "https://cf.nefusoft.my.id/:url"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}