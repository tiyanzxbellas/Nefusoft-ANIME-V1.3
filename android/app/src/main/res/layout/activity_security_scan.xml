<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:padding="24dp">

    <!-- Top Header Brand -->
    <LinearLayout
        android:id="@+id/brandLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NefuSoft"
            android:textColor="@color/gold_accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Security"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="normal" />
    </LinearLayout>

    <!-- Scanning Radar Area -->
    <FrameLayout
        android:id="@+id/scanningArea"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintTop_toBottomOf="@id/brandLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp">

        <!-- Rotating Radar/Ring background -->
        <ImageView
            android:id="@+id/scanningRadar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_radar_ring"
            android:contentDescription="Scanning Radar" />

        <!-- Shield logo inside -->
        <ImageView
            android:id="@+id/shieldLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_shield_scanning"
            android:contentDescription="Shield Logo" />
    </FrameLayout>

    <!-- Dynamic Status Title & Desc -->
    <TextView
        android:id="@+id/statusTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Menginisialisasi Scan..."
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/scanningArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/statusDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mempersiapkan verifikasi keamanan Google Play..."
        android:textColor="@color/white"
        android:alpha="0.7"
        android:textSize="14sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/statusTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <!-- Checklist of security indicators -->
    <LinearLayout
        android:id="@+id/scanDetailsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/statusDesc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Check 1: Play Protect -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/playProtectIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_pending"
                android:contentDescription="Status Icon" />

            <TextView
                android:id="@+id/playProtectStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mendeteksi Play Protect..."
                android:textColor="@color/white"
                android:alpha="0.6"
                android:textSize="14sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Check 2: Root check -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/rootIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_pending"
                android:contentDescription="Status Icon" />

            <TextView
                android:id="@+id/rootStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Memeriksa Hak Akses Root..."
                android:textColor="@color/white"
                android:alpha="0.6"
                android:textSize="14sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Check 3: Package Integrity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/integrityIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_pending"
                android:contentDescription="Status Icon" />

            <TextView
                android:id="@+id/integrityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Memverifikasi Integritas Paket..."
                android:textColor="@color/white"
                android:alpha="0.6"
                android:textSize="14sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Check 4: USB Debugging / Developer Options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/debuggingIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_pending"
                android:contentDescription="Status Icon" />

            <TextView
                android:id="@+id/debuggingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Memeriksa Opsi Pengembang..."
                android:textColor="@color/white"
                android:alpha="0.6"
                android:textSize="14sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Check 5: SSL / Secure Connection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/connectionIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_pending"
                android:contentDescription="Status Icon" />

            <TextView
                android:id="@+id/connectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Memeriksa Enkripsi SSL Jaringan..."
                android:textColor="@color/white"
                android:alpha="0.6"
                android:textSize="14sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Success Result Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/resultCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/dark_gray"
        app:strokeColor="#1F0F9D58"
        app:strokeWidth="1.5dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/scanDetailsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_shield_secure_green"
                android:contentDescription="Secured Icon" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sertifikasi Keamanan Aktif"
                    android:textColor="#0F9D58"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aplikasi ini 100% aman digunakan. Bebas dari virus, malware, adware, dan spyware berbahaya."
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:alpha="0.8"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Continue Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Lanjutkan Ke Aplikasi"
        android:textColor="@color/dark_background"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="@color/gold_accent"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
